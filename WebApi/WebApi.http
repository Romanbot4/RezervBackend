}

###

@accessToken = {{login.response.body.token.accessToken}}

GET {{WebApi_HostAddress}}/api/businesses
Accept: application/json

###

GET {{WebApi_HostAddress}}/api/packages
Accept: application/json

###

GET {{WebApi_HostAddress}}/api/packages?businessId=cf24fc77-facf-8d6e-9654-5b07b6cc8ad6
Accept: application/json

###

GET {{WebApi_HostAddress}}/api/packages/mine
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{WebApi_HostAddress}}/api/timetable
Accept: application/json

###

GET {{WebApi_HostAddress}}/api/timetable?businessId=cf24fc77-facf-8d6e-9654-5b07b6cc8ad6&date=2026-09-22
Accept: application/json

###

GET {{WebApi_HostAddress}}/api/bookings/mine
Accept: application/json
Authorization: Bearer {{accessToken}}

###

// Business mismatch. Fitness package against a Rhino Yoga class
POST {{WebApi_HostAddress}}/api/bookings
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "scheduleId": "29430c46-33b6-e642-5431-7df2fc70a73e",
  "customerPackageId": "85476e89-a7ff-0fde-07a2-033e3752c313",
  "joinWaitlistIfFull": true
}

